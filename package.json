{
  "name": "moveit-service",
  "version": "4.3.0",
  "description": "MoveIT service — система учёта ТМЦ с адресным хранением и ролевой моделью admin / supervisor / mol / user",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "setup": "npm install && npm run migrate && npm run seed",
    "reset": "npm run migrate && npm run seed -- --force",
    "check-db": "node scripts/check-db.js",
    "check-catalog": "node scripts/check-catalog.js",
    "check-models": "node scripts/check-models.js",
    "check-roles": "node scripts/check-roles.js",
    "check-css": "node scripts/check-css.js",
    "create-admin": "node scripts/create-admin.js",
    "reset-admin": "node scripts/reset-admin-password.js",
    "fix-assignments": "node scripts/fix-double-assignments.js",
    "clean-test-data": "node scripts/clean-test-data.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "connect-sqlite3": "^0.9.13",
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  },
  "keywords": [
    "equipment",
    "inventory",
    "warehouse",
    "workplace",
    "storage",
    "management",
    "nodejs",
    "express",
    "sqlite",
    "auth"
  ],
  "author": "Дмитрий Хлюпин",
  "license": "MIT"
}